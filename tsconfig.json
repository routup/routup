{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "paths": {
            "routup": ["./src/index.ts"],
            "routup/cloudflare": ["./src/_entries/cloudflare.ts"]
        }
    },
    "include": [
        "src/**/*",
        "test/**/*",
        "docs/examples/**/*"
    ]
}
